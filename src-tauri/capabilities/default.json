{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "notification:default",
    "haptics:allow-impact-feedback",
    "admob:default",
    "iap:default",
    "firebase:default",
    "stockage:default",
    "opener:default",
    "in-app-review:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://*" },
        { "url": "itms-apps://*" },
        { "url": "market://*" }
      ]
    }
  ]
}
