node_modules
.next
out
.DS_Store
.env*
!.env.example
*.tsbuildinfo
next-env.d.ts
# Tauri build artefacts
src-tauri/target
# gen/ : on versionne les projets natifs (gen/apple, gen/android) pour préserver
# la config de signature/entitlements ; seuls les artefacts générés sont ignorés
# (schemas + dossiers couverts par gen/apple/.gitignore : build/, Externals/, xcuserdata/).
src-tauri/gen/schemas/

# Superpowers brainstorm/mockup workspace
.superpowers/

# Originaux des items avant suppression du fond — non déployés
archives/

# PNGs sources des illustrations (générés par gen:*) : seuls les WebP
# servis sont commités, les PNG restent locaux.
public/items/*.png
public/brocantes/*.png
public/brocantes/scenes/*.png
public/qg/*.png
public/atelier/*.png
scripts/save-demo.json
scripts/save-demo.err
marketing/appstore/.captures/

# Artefacts générés Xcode/Tauri (régénérés au build)
src-tauri/gen/apple/app.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
src-tauri/vendor/tauri-plugin-admob/.tauri/
src-tauri/vendor/tauri-plugin-admob/ios/Package.resolved
src-tauri/vendor/tauri-plugin-admob/ios/.build/
src-tauri/vendor/tauri-plugin-iap/.tauri/
src-tauri/vendor/tauri-plugin-iap/ios/Package.resolved
src-tauri/vendor/tauri-plugin-iap/ios/.build/
src-tauri/vendor/tauri-plugin-firebase/.tauri/
src-tauri/vendor/tauri-plugin-firebase/ios/Package.resolved
src-tauri/vendor/tauri-plugin-firebase/ios/.build/
marketing/appstore/.planches/

# tauri-plugin-stockage est un plugin maison (pas un vendor drop crates.io
# comme tauri-plugin-notification) : ni tauri-plugin-firebase ni
# tauri-plugin-iap ne committent de Cargo.lock, et une fois le plugin
# enregistré dans src-tauri/Cargo.toml, ce lockfile local devient
# vestigial (le Cargo.lock racine du workspace prend le relais).
src-tauri/vendor/tauri-plugin-stockage/Cargo.lock
# target/ standalone : présent car la tâche 1 a fait tourner `cargo test`
# directement dans ce répertoire, hors du workspace src-tauri.
src-tauri/vendor/tauri-plugin-stockage/target/
