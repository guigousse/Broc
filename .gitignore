# Tauri build artefacts
src-tauri/target
# gen/ : on versionne les projets natifs (gen/apple, gen/android) pour préserver
# la config de signature/entitlements ; seuls les artefacts générés sont ignorés
# (schemas + dossiers couverts par gen/apple/.gitignore : build/, Externals/, xcuserdata/).
src-tauri/gen/schemas/

# Superpowers brainstorm/mockup workspace
.superpowers/

# Originaux des items avant suppression du fond — non déployés
archives/

# PNGs sources des illustrations (générés par gen:*) : seuls les WebP
# servis sont commités, les PNG restent locaux.
public/items/*.png
public/brocantes/*.png
public/brocantes/scenes/*.png
public/qg/*.png
public/atelier/*.png
scripts/save-demo.json
scripts/save-demo.err
marketing/appstore/.captures/

# Artefacts générés Xcode/Tauri (régénérés au build)
src-tauri/gen/apple/app.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
src-tauri/vendor/tauri-plugin-admob/.tauri/
src-tauri/vendor/tauri-plugin-admob/ios/Package.resolved
src-tauri/vendor/tauri-plugin-iap/.tauri/
